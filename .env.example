# ─────────────────────────────────────────────────────────────────────────────
# LyoDex — environment configuration
#
# Copy to `.env` and fill in. Never commit the filled-in file.
# Everything marked REQUIRED must be set before the server will run correctly
# in production; the server refuses to start without JWT_SECRET when
# NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production

# REQUIRED. Port the API server binds to. The server throws if unset.
PORT=8080

# REQUIRED. PostgreSQL connection string.
# With docker-compose this is overridden to point at the bundled `db` service.
DATABASE_URL=postgresql://user:password@host:5432/lyodex

# docker-compose only — credentials for the bundled Postgres container.
POSTGRES_USER=lyodex
POSTGRES_PASSWORD=
POSTGRES_DB=lyodex
# Host port the app is published on by docker-compose.
APP_PORT=8080

# REQUIRED in production. Random 32+ character string used to sign session JWTs.
# Generate:  openssl rand -hex 48
# Rotating this invalidates every existing session.
JWT_SECRET=

# Comma-separated list of origins allowed to call the API with credentials.
# Must include the exact scheme and host the browser uses.
ALLOWED_ORIGINS=https://lyodex.com,https://www.lyodex.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# Set these to run anywhere. When both are absent AND the process is running on
# Replit with the Stripe integration connected, keys are read from the Replit
# connector instead. Env vars always take priority.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secrets from the Stripe dashboard.
#   /api/stripe/fee-webhook      -> STRIPE_WEBHOOK_SECRET
#   /api/stripe/connect-webhook  -> STRIPE_CONNECT_WEBHOOK_SECRET  (payload style: Thin)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Public base URL, used to build Stripe redirect/return URLs.
PUBLIC_APP_URL=https://lyodex.com

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Without these, transactional email silently does not send.
# Configure SPF/DKIM/DMARC on the sending domain or mail lands in spam.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Destination for admin alerts. Defaults to audit@lyodex.com.
ADMIN_EMAIL=audit@lyodex.com

# ── Object storage (operator certification documents) ────────────────────────
# Off Replit, provide Google Cloud Storage credentials one of two ways:
#   1. GOOGLE_APPLICATION_CREDENTIALS = absolute path to a service-account JSON
#   2. GCS_SERVICE_ACCOUNT_KEY        = the service-account JSON inline
# On Replit, leave both unset and the object-storage sidecar is used.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json
# GCS_SERVICE_ACCOUNT_KEY=
# GCS_PROJECT_ID=

# Bucket paths used by the storage service.
PRIVATE_OBJECT_DIR=/lyodex-private
PUBLIC_OBJECT_SEARCH_PATHS=/lyodex-public

# ── Frontend build ───────────────────────────────────────────────────────────
# Sub-path the SPA is served from. Leave as "/" for a root domain.
BASE_PATH=/
